# ==============================================================================
# Codyssey E1-1 Workstation Environment Configuration (.env)
# 12-Factor App: 설정(Configuration)과 코드의 분리
# ==============================================================================

# Application Environment Mode (development / staging / production)
APP_ENV=production

# Web Server External Host Ports
HOST_PORT=8080
HOST_PORT_SECONDARY=8081

# Redis Cache Service Port
CACHE_PORT=6379

# Container Resource & Restart Settings
COMPOSE_PROJECT_NAME=codyssey-workstation
LOG_LEVEL=info
